# Runtime
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v2
CORS_ORIGINS=http://localhost:3000
FRONTEND_PORT=3000
BACKEND_PORT=8000
# Technical demo only. Production builds default to false when this is omitted.
WEB_CAPTURE_ENABLED=true
# Temporary reviewer OCR rerun; must stay false outside the technical-demo profile.
DEMO_OCR_RERUN_ENABLED=true

# Database
POSTGRES_DB=vid_ekyc
POSTGRES_USER=vid
POSTGRES_PASSWORD=change-this-database-password

# Replace all values below outside local development
TOKEN_SECRET=change-this-token-hmac-secret
EVIDENCE_KEY=change-this-evidence-encryption-key
VID_CLIENT_KEY=local-vid-client-key
REVIEWER_TOKEN=local-reviewer-token

# Data lifecycle
PURGE_INTERVAL_HOURS=24
DEVELOPMENT_RETENTION_HOURS=168
WEBHOOK_ALLOWLIST=

# Model/runtime
AI_DEVICE=cpu
MAX_VIDEO_FRAMES=36
MAX_FACE_MATCH_FRAMES=12
TAG=latest

# Capability -> provider selection ("primary" or "primary,secondary" provider
# id). Which vendor/model is actually live in a deployment is operational
# information, not something to hardcode in source - defaults below match the
# technical-demo baseline; override per environment, never commit real
# pilot/production selections here.
# PROVIDER_DOCUMENT_OCR=rapidocr-ppocrv6-small
# PROVIDER_DOCUMENT_LAYOUT=cccd-layout-yolov11
# PROVIDER_PASSPORT_MRZ=icao-td3-rules
# PROVIDER_FACE_DETECTION=insightface-buffalo-l-scrfd
# PROVIDER_FACE_EMBEDDING=insightface-buffalo-l-arcface
# PROVIDER_FACE_MATCHING=insightface-buffalo-l-median
# PROVIDER_PASSIVE_LIVENESS=minifasnet-v2
# PROVIDER_ACTIVE_LIVENESS=scrfd-head-pose-rules
# PROVIDER_VISUAL_DEEPFAKE=deepfake-detector-v2-q4
# PROVIDER_VOICE_CHALLENGE=vosk-small-vn-0.4
# PROVIDER_LIP_SYNC=syncnet-s3fd-http
# PROVIDER_REPLAY_ATTACK=heuristic-replay-v1
# PROVIDER_CAMERA_INJECTION=heuristic-camera-injection-v1

# BuildKit secret; never copy the internal CA into Git or the Docker build context.
HOST_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
